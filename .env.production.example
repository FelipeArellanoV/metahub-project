# MetaHub — variables de PRODUCCIÓN.
# Copie este archivo a .env.production (no se versiona) y complete TODOS los valores.
# docker-compose.prod.yml no tiene valores por defecto para estas variables: si falta una,
# no arranca. Guía: docs/despliegue.md

# --- Dominio y HTTPS --------------------------------------------------------------
# Nombre DNS que apunta a la IP pública del servidor (registro A/AAAA).
DOMAIN=
# Correo para Let's Encrypt (avisos de certificados).
ACME_EMAIL=

# --- Base de datos ----------------------------------------------------------------
POSTGRES_USER=
# Contraseña larga y aleatoria: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# (sin caracteres especiales para que la URL de conexión sea válida)
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- API --------------------------------------------------------------------------
# Secreto de firma de sesiones, mínimo 32 caracteres: openssl rand -hex 32
JWT_SECRET=
# Días que se conservan los videos de los atletas antes de purgarlos (lo fija la institución).
RETENTION_DAYS=

# --- Respaldos --------------------------------------------------------------------
# Carpeta del servidor donde se guardan los respaldos (ruta absoluta), p. ej. /srv/metahub/respaldos
BACKUP_DIR=
# Hora UTC del respaldo diario (0-23). Chile continental: UTC-3/UTC-4 -> 7 = 03:00-04:00 hora local.
BACKUP_HOUR_UTC=
# Días que se conservan los respaldos.
BACKUP_KEEP_DAYS=

# --- Opcionales -------------------------------------------------------------------
# Videos analizados en paralelo (por defecto 1; súbalo solo si el servidor tiene CPU de sobra).
# VIDEO_QUEUE_CONCURRENCY=1
# Núcleos de CPU máximos para el servicio de visión (por defecto 2).
# CV_CPUS=2
# Monitoreo de respaldos: URL de un "dead man's switch" (p. ej. https://hc-ping.com/<uuid>).
# Se llama tras cada respaldo correcto; si deja de llamarse, el servicio externo avisa por correo.
# BACKUP_PING_URL=
