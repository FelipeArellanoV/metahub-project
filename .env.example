# MetaHub — variables de DESARROLLO local (docker-compose.yml).
# Copie este archivo a .env. NO suba .env al repositorio.
# Producción usa otro archivo y otro compose: .env.production.example y docs/despliegue.md

# PostgreSQL & TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=metahub_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend API
PORT=3000
# Obligatorio. Genere un secreto largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
DATABASE_URL=postgres://postgres:postgres@db:5432/metahub_db
# Orígenes permitidos para CORS (separados por coma). En desarrollo: localhost y el servidor de Vite.
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

# CV Service (solo lo llama la API; el navegador pasa por /api/cv con sesión iniciada)
CV_SERVICE_URL=http://cv-service:8000

# Límites de tasa (opcionales; valores por defecto entre paréntesis)
# RATE_LOGIN_PER_ACCOUNT=5    # intentos de login por IP+correo cada 15 min (5)
# RATE_LOGIN_PER_IP=30        # intentos de login por IP cada 15 min (30)
# RATE_REGISTER_PER_IP=10     # registros por IP por hora (10)
# RATE_UPLOAD_PER_USER=20     # videos por usuario por hora (20)
# RATE_CV_PER_USER=10         # análisis directos del laboratorio por usuario cada 10 min (10)

# Cola de análisis de video (opcionales)
# VIDEO_QUEUE_CONCURRENCY=1   # videos analizados en paralelo
# VIDEO_QUEUE_MAX_ATTEMPTS=3  # intentos automáticos ante fallos transitorios

# Solo desarrollo y pruebas (ADR-018). En operación real déjelas sin definir o en false.
# ALLOW_SAMPLE_VIDEO=false   # servicio de visión: permite analizar el video de muestra
# ALLOW_DEMO_SEED=false      # API sin PostgreSQL: crea datos y cuentas de demostración
# VITE_ENABLE_DEMO=false     # frontend (al compilar): habilita el acceso ?demo=1
