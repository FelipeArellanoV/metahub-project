# MetaHub Project Environment Variables
# Copie este archivo a .env y reemplace los valores. NO suba .env al repositorio.

# PostgreSQL & TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=metahub_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend API
PORT=3000
# Obligatorio. Genere un secreto largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
DATABASE_URL=postgres://postgres:postgres@db:5432/metahub_db

# CV Service
CV_SERVICE_URL=http://cv-service:8000
